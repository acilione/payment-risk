      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(flink_taskmanager_job_task_operator_risk_transactions_valid_total[1m]))",
          "refId": "A",
          "legendFormat": "Valid payments / sec",
          "range": true,
          "instant": false,
          "editorMode": "code"
