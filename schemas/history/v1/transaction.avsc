{
  "type": "record",
  "name": "Transaction",
  "namespace": "com.portfolio.paymentrisk.avro",
  "fields": [
    {
      "name": "event_id",
      "type": "string"
    },
    {
      "name": "transaction_id",
      "type": "string"
    },
    {
      "name": "customer_id",
      "type": "string"
    },
    {
      "name": "merchant_id",
      "type": "string"
    },
    {
      "name": "amount_minor",
      "type": "long"
    },
    {
      "name": "currency",
      "type": "string"
    },
    {
      "name": "country",
      "type": "string"
    },
    {
      "name": "device_id",
      "type": "string"
    },
    {
      "name": "status",
      "type": {
        "type": "enum",
        "name": "PaymentStatus",
        "symbols": [
          "APPROVED",
          "DECLINED"
        ]
      }
    },
    {
      "name": "event_time",
      "type": {
        "type": "long",
        "logicalType": "timestamp-millis"
      }
    },
    {
      "name": "producer_time",
      "type": "long"
    }
  ]
}
