{
  "name": "payment-risk-observatory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.10.0 <25"
  },
  "scripts": {
    "dev": "vite",
    "server": "node server/index.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "start": "node server/index.mjs",
    "test": "node --test server/*.test.mjs",
    "format": "prettier --write src server *.ts *.json index.html",
    "format:check": "prettier --check src server *.ts *.json index.html"
  },
  "dependencies": {
    "@fastify/helmet": "13.1.1",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/static": "10.1.3",
    "fastify": "5.12.3",
    "lucide-react": "1.43.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "prettier": "3.9.6",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  }
}
