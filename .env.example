# Copy to .env and run scripts/init-env.py to generate local credentials.
MINIO_ROOT_USER=payment_risk
MINIO_ROOT_PASSWORD=
CLICKHOUSE_USER=risk
CLICKHOUSE_PASSWORD=
GRAFANA_ADMIN_PASSWORD=
REGISTRY_DB_PASSWORD=

# Database ingestion: flush at the first bound, and always at the end of a Kafka poll.
INGEST_BATCH_BYTES=1048576
INGEST_BATCH_ROWS=1000
INGEST_BATCH_MS=1000
INGEST_MAX_POLL_RECORDS=250
